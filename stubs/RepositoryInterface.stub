<?php

declare(strict_types=1);

namespace App\Domain;

/**
 * {TableComment}リポジトリインターフェース
 */
interface {ModelName}RepositoryInterface
{
    /**
     * @param integer ${lowerModelName}Id
     * @return {ModelName}|null
     */
    public function get(int ${lowerModelName}Id): ?{ModelName};

    /**
     * @return array<integer, {ModelName}>
     */
    public function getAll(): array;

    /**
     * @param {ModelName} ${lowerModelName}
     * @return {ModelName}
     */
    public function create({ModelName} ${lowerModelName}): {ModelName};

    /**
     * @param {ModelName} ${lowerModelName}
     * @return {ModelName}
     */
    public function update({ModelName} ${lowerModelName}): {ModelName};

    /**
     * @param integer ${lowerModelName}Id
     * @return boolean
     */
    public function delete(int ${lowerModelName}Id): bool;
}
