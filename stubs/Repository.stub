<?php

declare(strict_types=1);

namespace App\Infrastructure\Eloquent;

use App\Domain\{ModelName};
use App\Domain\{ModelName}RepositoryInterface;
use Illuminate\Support\Facades\DB;

/**
 * Eloquent{TableComment}リポジトリ
 */
class Eloquent{ModelName}Repository implements {ModelName}RepositoryInterface
{
    /**
     * {@inheritDoc}
     */
    public function get(int ${lowerModelName}Id): ?{ModelName}
    {
        $e{ModelName} = Eloquent{ModelName}::where('{PrimaryKey}', ${lowerModelName}Id)->first();
        return ($e{ModelName}) ? $e{ModelName}->to{ModelName}() : null;
    }

    /**
     * {@inheritDoc}
     */
    public function getAll(): array
    {
        $e{ModelName}s = Eloquent{ModelName}::get();
        return $e{ModelName}s->map->to{ModelName}()->all();
    }

    /**
     * {@inheritDoc}
     */
    public function create({ModelName} ${lowerModelName}): {ModelName}
    {
        $e{ModelName} = DB::transaction(function () use (${lowerModelName}): Eloquent{ModelName} {
            $e{ModelName} = Eloquent{ModelName}::create([
                {CreateDatabaseParam}
            ]);
            return $e{ModelName};
        });
        return $e{ModelName}->to{ModelName}();
    }

    /**
     * {@inheritDoc}
     */
    public function update({ModelName} ${lowerModelName}): {ModelName}
    {
        $e{ModelName} = DB::transaction(function () use (${lowerModelName}): Eloquent{ModelName} {
            $e{ModelName} = Eloquent{ModelName}::where('{PrimaryKey}', ${lowerModelName}->{lowerModelName}Id)
                ->lockForUpdate()
                ->first();
            $e{ModelName}->fill([
                {UpdateDatabaseParam}
            ])->save();
            return $e{ModelName};
        });
        return $e{ModelName}->to{ModelName}();
    }

    /**
     * {@inheritDoc}
     */
    public function delete(int ${lowerModelName}Id): bool
    {
        return DB::transaction(function () use (${lowerModelName}Id): bool {
            $e{ModelName} = Eloquent{ModelName}::find(${lowerModelName}Id);
            return $e{ModelName} ? $e{ModelName}->delete() : false;
        });
    }
}
